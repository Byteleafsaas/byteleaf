# Copy to .env.local and fill in. Never commit .env.local.

# Dev database: `docker compose up -d` starts MongoDB on this address (host port 27117 so it never clashes with another local MongoDB).
MONGODB_URI=mongodb://127.0.0.1:27117/byteleaf

# Public base URL of the site (used in emails and reset links).
APP_URL=http://localhost:3000

# SMTP. Leave SMTP_HOST empty in dev and emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="byteleaf <no-reply@yourdomain.co.za>"

# Object storage for project images: your Garage (or any S3-compatible) server. Path-style addressing is used.
# Locally: npm run db:up && npm run garage:setup fills these in. Leave S3_ENDPOINT empty to store files in ./storage instead.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=byteleaf
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Encrypts two-step verification secrets at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# Knowledge assistant AI: DeepSeek (same provider and names as Yenza). Leave the key empty and the assistant quotes its sources instead.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# Most AI-written answers allowed per day across all visitors of the public demo.
ASSISTANT_DAILY_LIMIT=1500

# WhatsApp booking assistant (Meta WhatsApp Business Cloud API). See WHATSAPP.md. Leave empty to use only the website simulator.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_CLINIC=
WHATSAPP_SALON_TEMPLATE=
CRON_SECRET=
